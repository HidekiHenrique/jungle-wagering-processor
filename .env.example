# Copy to .env (`cp .env.example .env`). Bun loads .env automatically.
NODE_ENV=development
HTTP_PORT=3000
LOG_LEVEL=info

DB_HOST=localhost
DB_PORT=5432
DB_USER=wagering
DB_PASSWORD=wagering
DB_NAME=wagering
DB_POOL_MAX=10
# Max wait for a wallet row lock before failing with a transient error
DB_LOCK_TIMEOUT_MS=5000

# PENDING_REFERENCE retries: delay = min(base * 2^(n-1), max), up to max attempts
PENDING_REFERENCE_BASE_DELAY_MS=2000
PENDING_REFERENCE_MAX_DELAY_MS=300000
PENDING_REFERENCE_MAX_ATTEMPTS=10

SQS_ENDPOINT=http://localhost:4566
SQS_REGION=us-east-1
SQS_ACCESS_KEY_ID=test
SQS_SECRET_ACCESS_KEY=test
SQS_WAGER_QUEUE=wager-transactions.fifo
SQS_WAGER_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wallet-events.fifo

# Optional (defaults shown)
# SQS_WAIT_TIME_SECONDS=10
# SQS_RETRY_BASE_DELAY_SECONDS=1
# SQS_RETRY_MAX_DELAY_SECONDS=60
# SQS_CONSUMER_ENABLED=true
# OUTBOX_RELAY_ENABLED=true
# OUTBOX_POLL_INTERVAL_MS=500
# OUTBOX_BATCH_SIZE=50
# SHUTDOWN_TIMEOUT_MS=20000   (must exceed SQS_WAIT_TIME_SECONDS)
