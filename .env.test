# Loaded by `bun test` (NODE_ENV=test) on top of .env. Uses an isolated database.
LOG_LEVEL=error
DB_NAME=wagering_test
# Concurrency tests open many transactions at once.
DB_POOL_MAX=30
DB_LOCK_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=20000
# Background workers are started explicitly by the tests that need them.
SQS_CONSUMER_ENABLED=false
OUTBOX_RELAY_ENABLED=false
PENDING_REFERENCE_WORKER_ENABLED=false
SQS_WAIT_TIME_SECONDS=1
